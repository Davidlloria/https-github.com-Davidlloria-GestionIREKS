# FatSecret fallback loaded by app.services.fatsecret_client.
# Other runtime variables should be set in the shell or OS environment.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
FATSECRET_SCOPE=basic

# External read-only document library. Empty uses sibling Documentos.
GESTION_IREKS_DOCUMENTS_DIR=
# Local Ollama embedding model; it must already be installed.
GESTION_IREKS_EMBEDDING_MODEL=embeddinggemma
